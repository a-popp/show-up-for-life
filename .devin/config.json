{
  "permissions": {
    "allow": [
      "read",
      "grep",
      "glob",
      "Write(**)",
      "Exec(git status)",
      "Exec(git diff)",
      "Exec(git log)",
      "Exec(git show)",
      "Exec(git ls-files)",
      "Exec(git ls-remote)",
      "Exec(git check-ignore)",
      "Exec(npm run)",
      "Exec(npm test)",
      "Exec(python scripts/check_workspace.py)",
      "Exec(python scripts/check_secrets.py)",
      "Exec(python -m unittest)",
      "Exec(python -m py_compile)",
      "Exec(.venv-tools/Scripts/python)",
      "Exec(.venv-tools/Scripts/pre-commit)",
      "Exec(.venv-tools/bin/python)",
      "Exec(.venv-tools/bin/pre-commit)",
      "mcp__github__get_*",
      "mcp__github__list_*",
      "mcp__github__search_*",
      "mcp__github__issue_read",
      "mcp__github__pull_request_read",
      "mcp__github-mcp-server__get_*",
      "mcp__github-mcp-server__list_*",
      "mcp__github-mcp-server__search_*",
      "mcp__github-mcp-server__issue_read",
      "mcp__github-mcp-server__pull_request_read",
      "mcp__digitalocean__find_tools",
      "mcp__digitalocean__retrieve_schema"
    ],
    "deny": [
      "Read(.git/**)",
      "Write(.git/**)",
      "Read(**/.env)",
      "Write(**/.env)",
      "Read(**/.env.local)",
      "Write(**/.env.local)",
      "Read(**/.env.development)",
      "Write(**/.env.development)",
      "Read(**/.env.production)",
      "Write(**/.env.production)",
      "Read(**/.env.test)",
      "Write(**/.env.test)",
      "Read(**/*.key)",
      "Write(**/*.key)",
      "Read(**/*.pem)",
      "Write(**/*.pem)",
      "Read(**/*.p12)",
      "Write(**/*.p12)",
      "Read(**/*.pfx)",
      "Write(**/*.pfx)",
      "Read(**/id_rsa)",
      "Write(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Write(**/id_ed25519)",
      "Read(**/secrets/**)",
      "Write(**/secrets/**)",
      "Read(.devin/config.local.json)",
      "Write(.devin/config.local.json)",
      "Read(.devin/mcp_config.local.json)",
      "Write(.devin/mcp_config.local.json)",
      "Exec(rm -rf)",
      "Exec(sudo)",
      "mcp__github__delete_repository",
      "mcp__github-mcp-server__delete_repository"
    ],
    "ask": [
      "exec",
      "Write(.devin/**)",
      "Write(.github/**)",
      "mcp__*"
    ]
  },
  "read_config_from": {
    "agents_standard": true,
    "cursor": false,
    "windsurf": false,
    "claude": false,
    "copilot": false,
    "codex": false,
    "kiro": false,
    "opencode": false,
    "zed": false
  }
}
